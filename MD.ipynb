    "z_min    = 7  # Å, 두 번째 레이어 하한\n",
    "z_max    = 10  # Å, 두 번째 레이어 상한\n",
    "\n",
    "# ===== 트라젝토리 로드 =====\n",
    "frames = read(trajectory_file, index=':')\n",
    "\n",
    "# ===== 수소 결합 분포 수집 =====\n",
    "all_hb_counts = []\n",
    "\n",
    "for atoms in tqdm(frames, desc=\"수소 결합 분포 계산\"):\n",
    "    positions = atoms.get_positions()\n",
    "    symbols   = atoms.get_chemical_symbols()\n",
    "\n",
    "    # 전체 산소, 수소 인덱스\n",
    "    all_O_indices = [i for i, s in enumerate(symbols) if s == 'O']\n",
    "    H_indices     = [i for i, s in enumerate(symbols) if s == 'H']\n",
    "\n",
    "    # 두 번째 레이어에 있는 O만 선택\n",
    "    layer_O = [i for i in all_O_indices\n",
    "               if z_min < positions[i][2] < z_max]\n",
    "\n",
    "    for O_idx in layer_O:\n",
    "        # O→H 거리 계산 (PBC 고려)\n",
    "        d_OH = atoms.get_distances(O_idx, H_indices, mic=True)\n",
    "        # 물 분자 판단: H 2개 이상 근접해야 함\n",
    "        if np.sum(d_OH <= min_bond) < 2:\n",
    "            continue\n",
    "\n",
    "        # O→H 수소 결합 수\n",
    "        count_OH = np.sum((d_OH > min_bond) & (d_OH < cutoff))\n",
    "\n",
    "        # 가장 가까운 두 H 선택\n",
    "        closest = np.argsort(d_OH)[:2]\n",
    "        H1_idx, H2_idx = H_indices[closest[0]], H_indices[closest[1]]\n",
    "\n",
    "        # H1→O (all layers)\n",
    "        d_H1O = atoms.get_distances(H1_idx, all_O_indices, mic=True)\n",
    "        self_i = all_O_indices.index(O_idx)\n",
    "        d_H1O[self_i] = np.inf\n",
    "        count_H1O = np.sum((d_H1O > min_bond) & (d_H1O < cutoff))\n",
    "\n",
    "        # H2→O (all layers)\n",
    "        d_H2O = atoms.get_distances(H2_idx, all_O_indices, mic=True)\n",
    "        d_H2O[self_i] = np.inf\n",
    "        count_H2O = np.sum((d_H2O > min_bond) & (d_H2O < cutoff))\n",
    "\n",
    "        all_hb_counts.append(count_OH + count_H1O + count_H2O)\n",
    "\n",
    "# ===== 히스토그램 그리기 =====\n",
